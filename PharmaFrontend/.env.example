# Frontend environment example for HcpPortalWeb
# Copy to .env.local for local development.

# Shared fallback base URL for both API clients.
# Leave empty in local dev to use Vite proxy (/api -> vite.config.ts target).
VITE_API_BASE_URL=

# Optional explicit backend URL overrides.
# Use when Pharma and HCP APIs run on different hosts.
VITE_PHARMA_API_BASE_URL=
VITE_HCP_API_BASE_URL=
