# Backend environment example for PharmaBackend
# Keep secrets out of source control. Use local secret stores for real values.

# Required fail-fast settings in Program.cs
ConnectionStrings__DefaultConnection=Server=<sql-server>;Database=<db>;Authentication=Active Directory Default;Encrypt=True
Redis__HostName=<redis-host>.redis.cache.windows.net
Redis__PrincipalId=<entra-object-id>

# Optional cloud configuration providers
AZURE_KEYVAULT_URI=https://<keyvault-name>.vault.azure.net/
AZURE_APPCONFIG_ENDPOINT=https://<appconfig-name>.azconfig.io

# Optional app settings
Seeding__ImageBaseUrl=https://<cdn-or-blob-base-url>/
AllowedHosts=*
