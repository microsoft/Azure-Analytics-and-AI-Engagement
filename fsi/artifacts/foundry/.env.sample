# =============================================================================
# FSI IQ DPoC - dev/test profile
# Copy to .env and (optionally) paste the AI Services key. This profile creates
# its own AI Search service and uses our Fabric Data Agent.
# =============================================================================

# create = provision our own search service | inherit = reuse PS-created resources
RESOURCE_SOURCE=create

# --- Azure / resource group -------------------------------------------------
AZURE_SUBSCRIPTION_ID=###AZURE_SUBSCRIPTION_ID###
AZURE_RESOURCE_GROUP=###AZURE_RESOURCE_GROUP###
AZURE_LOCATION=###AZURE_LOCATION###
AZURE_SEARCH_LOCATION=###AZURE_SEARCH_LOCATION###

# --- Foundry (AI Services account + project) --------------------------------
AZURE_AI_SERVICES_NAME=###AZURE_AI_SERVICES_NAME###
AZURE_AI_PROJECT_NAME=###AZURE_AI_PROJECT_NAME###
AZURE_AI_PROJECT_ENDPOINT=###AZURE_AI_PROJECT_ENDPOINT###
AZURE_AI_SERVICES_ENDPOINT=###AZURE_AI_SERVICES_ENDPOINT###
AZURE_AI_SERVICES_KEY=###AZURE_AI_SERVICES_KEY###

# --- Models (deployment name + underlying model id) -------------------------
AZURE_CHAT_DEPLOYMENT=###AZURE_CHAT_DEPLOYMENT###
AZURE_CHAT_MODEL=###AZURE_CHAT_DEPLOYMENT###
AZURE_KB_MODEL=###AZURE_CHAT_DEPLOYMENT###
AZURE_KB_MODEL_NAME=###AZURE_KB_MODEL_DEPLOYMENT###
AZURE_EMBEDDING_DEPLOYMENT=###AZURE_EMBEDDING_DEPLOYMENT###

# --- Azure AI Search (created by this script in create mode) ----------------
CREATE_SEARCH_SERVICE=true
AZURE_SEARCH_NAME=###AZURE_SEARCH_NAME###
AZURE_SEARCH_SKU=basic
AZURE_SEARCH_ENDPOINT=###AZURE_SEARCH_ENDPOINT###

# --- Foundry-layer artifact names (KB kept intact; sources renamed) ---------
INDEX_NAME=fsi-customer-documents
CUSTOMER_KS_NAME=fsi-customer-data
FABRIC_KS_NAME=fsi-financial-data-agent
KB_NAME=fsi-knowledge-base
KB_MCP_CONNECTION_NAME=fsi-kb-mcp-connection

# --- Fabric Data Agent (our FDA; Adnan tests his own) -----------------------
FABRIC_WORKSPACE_ID=###FABRIC_WORKSPACE_ID###
FABRIC_DATA_AGENT_ID=###FABRIC_DATA_AGENT_ID###

LOG_LEVEL=INFO
