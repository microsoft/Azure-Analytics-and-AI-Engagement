# =============================================================================
# ACA DPoC - Foundry deployment configuration
# acaSetup.ps1 copies this file to .env and replaces every ###TOKEN###.
# For a manual run, copy to .env and fill in the values yourself.
# No secrets are stored here: authentication uses the signed-in Azure identity.
# =============================================================================

# --- Azure / resource group -------------------------------------------------
AZURE_SUBSCRIPTION_ID=##AZURE_SUBSCRIPTION_ID##
AZURE_RESOURCE_GROUP=##AZURE_RESOURCE_GROUP##

# --- Foundry (AI Services account + project) --------------------------------
AZURE_AI_SERVICES_NAME=##AZURE_AI_SERVICES_NAME##
AZURE_AI_PROJECT_NAME=##AZURE_AI_PROJECT_NAME##
AZURE_AI_PROJECT_ENDPOINT=https://##AZURE_AI_SERVICES_NAME##.services.ai.azure.com/api/projects/##AZURE_AI_PROJECT_NAME##

# --- Model deployment used by the agent --------------------------------------
AZURE_CHAT_DEPLOYMENT=##AZURE_CHAT_DEPLOYMENT##

# --- MCP reconcile tool --------------------------------------------------------
FUNCTION_APP_NAME=##FUNCTION_APP_NAME##

# apim   = publish the MCP endpoint through API Management (production shape)
# direct = connect the agent straight to the Function App with its function key
MCP_GATEWAY_MODE=apim
APIM_NAME=##APIM_NAME##
APIM_WAIT_MINUTES=60

LOG_LEVEL=INFO

APPINSIGHTS_NAME=##APPINSIGHTS_NAME##
