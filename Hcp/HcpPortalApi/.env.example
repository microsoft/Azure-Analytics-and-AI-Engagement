# Backend environment example for HcpPortalApi
# Copy values to dotnet user-secrets or your deployment secret store.

# Required
ConnectionStrings__HcpSql=Server=tcp:<sql-server>.database.windows.net,1433;Initial Catalog=<db-name>;Encrypt=True;TrustServerCertificate=False;Authentication=Active Directory Default;
ServiceBus__FullyQualifiedNamespace=<servicebus-namespace>.servicebus.windows.net

# Recommended to set explicitly to avoid default mismatches
ServiceBus__QueueName=enrollment-events

# Optional AI and memory integrations
Foundry__Endpoint=https://<openai-resource>.openai.azure.com/
Foundry__EmbeddingModelDeployment=text-embedding-3-small
Cosmos__AccountEndpoint=https://<cosmos-account>.documents.azure.com:443/
Cosmos__DatabaseName=hcp-ai-memory
HorizonDb__ConnectionString=Host=<horizon-host>;Port=5432;Database=<db>;Username=<user>;Ssl Mode=Require;Trust Server Certificate=false
ConnectionStrings__Redis=<redis-host>:6380,ssl=True,abortConnect=False

# Optional sandbox session defaults
SandboxGroup__Name=
SandboxGroup__ManagementEndpoint=

# Required for sandbox-executed assistant flow
SandboxRuntime__BaseUrlTemplate=
SandboxRuntime__AssistantQueryPath=/api/assistant/query
SandboxRuntime__Audience=

# Optional telemetry
OpenTelemetry__Otlp__Endpoint=

# Optional CORS (index notation for arrays)
Cors__AllowedOrigins__0=http://localhost:5174
